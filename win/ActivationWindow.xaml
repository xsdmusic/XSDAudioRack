<Window x:Class="XSDAudioRack.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XSD Audio Rack — 激活" Height="640" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WinBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20">
            <TextBlock Text="软件激活" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtReason" Text="本软件提供 3 天免费试用，试用结束后需激活。"
                       Foreground="{DynamicResource RedBrush}" FontSize="14"
                       Margin="0,8,0,4" TextWrapping="Wrap"/>

            <!-- ================= 扫码付款（默认展示） ================= -->
            <Border CornerRadius="10" Background="{DynamicResource CardBrush}"
                    Padding="18,14" Margin="0,10,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="支付宝扫码 · 终身使用" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPrice" Text="¥9.9 元 · 一台电脑永久授权" FontSize="13"
                               Foreground="{DynamicResource SecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,8"/>

                    <Border CornerRadius="8" Background="White" Width="216" Height="216">
                        <Grid>
                            <Image x:Name="ImgQr" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                            <StackPanel x:Name="QrLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtQrState" Text="正在获取付款二维码…" FontSize="13"
                                           Foreground="#888888" HorizontalAlignment="Center"/>
                                <Button x:Name="BtnRetryQr" Content="重新获取" Click="BtnRetryQr_Click"
                                        Visibility="Collapsed" Margin="0,10,0,0" Padding="14,6"
                                        Style="{StaticResource SmallButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtPayStatus" Text="打开手机支付宝扫一扫，付款后自动激活" FontSize="13"
                               Foreground="{DynamicResource SecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"
                               MaxWidth="420" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13">
                <Run Text="官方网站："/>
                <Hyperlink x:Name="LnkSite" NavigateUri="https://xsdmusic.cn" RequestNavigate="LnkSite_Click">
                    <Run Text="xsdmusic.cn"/>
                </Hyperlink>
                <Run Text="    客服微信：277878676" Foreground="{DynamicResource SecondaryBrush}"/>
            </TextBlock>

            <!-- ================= 手动激活（折叠） ================= -->
            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SecondaryBrush}">
                <Hyperlink x:Name="LnkManual" RequestNavigate="LnkManual_Click"
                           Foreground="{DynamicResource SecondaryBrush}">
                    <Run Text="已有激活码？点此手动输入 ▸"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel x:Name="PanelManual" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="本机机器码（复制发给开发者，换取激活码）" FontSize="12"
                           Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="BtnCopyCode" Content="复制" Click="BtnCopyCode_Click"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                    <Border CornerRadius="8" Background="{DynamicResource CardBrush}" Padding="10,8">
                        <TextBlock x:Name="TbMachineCode" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{DynamicResource BrandBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DockPanel>

                <TextBlock Text="激活码（粘贴你收到的授权码）" FontSize="12"
                           Foreground="{DynamicResource SecondaryBrush}" Margin="0,14,0,6"/>
                <TextBox x:Name="TbActivation" FontSize="15" TextWrapping="Wrap" AcceptsReturn="False"
                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource SepBrush}" Padding="8,6" Height="70"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

                <Button x:Name="BtnActivate" Content="激  活" Height="42" Margin="0,14,0,0" Click="BtnActivate_Click"
                        Style="{StaticResource AccentButton}" FontSize="16"/>
            </StackPanel>

            <TextBlock x:Name="TxtResult" Text="" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource SecondaryBrush}"/>

            <Button x:Name="BtnExit" Content="退出程序" Margin="0,16,0,0" Click="BtnExit_Click"
                    HorizontalAlignment="Center" Style="{StaticResource SmallButton}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
