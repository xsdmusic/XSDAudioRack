<Window x:Class="XSDAudioRack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XSD Audio Rack" Width="1010" Height="840"
        Icon="app.ico"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WinBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- ============ 文本样式（控件样式见 Themes/Controls.xaml）============ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="88"/>
        </Style>

    </Window.Resources>

    <!-- ==================== 整体：顶部工具栏 + 三栏内容 ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─────────── 顶部工具栏 ─────────── -->
        <DockPanel Grid.Row="0" Margin="25,0,20,0">
            <TextBlock Text="XSD Audio Rack" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnStartStop" Width="36" Height="36" Style="{StaticResource AccentButton}"
                        Content="▶" FontSize="14" Click="BtnStartStop_Click" ToolTip="启动 / 停止（空格）"/>
                <Button x:Name="BtnRefresh" Width="36" Height="36" Margin="8,0,0,0"
                        Content="⟳" FontSize="15" Click="BtnRefresh_Click" ToolTip="刷新设备"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{DynamicResource TertiaryBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Stopped" FontSize="12" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
                    <TextBlock x:Name="InfoText" Text="" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}"/>
                </StackPanel>
                <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" Margin="14,0,0,0"
                        Content="🌙" FontSize="14" Click="BtnTheme_Click" ToolTip="切换浅色 / 深色"/>
                <Button x:Name="BtnSidebar" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                        Content="☰" FontSize="14" Click="BtnSidebar_Click" ToolTip="显示 / 隐藏设备栏"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource SepBrush}"/>

        <!-- ─────────── 三栏 ─────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainCol" Width="565"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition x:Name="DeviceCol" Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 中栏：插件链 + Send + 虚拟输入 + 底部 ═══════════ -->
            <DockPanel Grid.Column="0" Background="{DynamicResource PanelBrush}">

                <!-- 标题行 -->
                <Grid DockPanel.Dock="Top" Margin="25,18,25,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PLUGIN CHAIN" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddPlugin" Grid.Column="2" Style="{StaticResource AccentButton}"
                            Height="26" FontSize="12" Padding="12,2" Margin="30,0,12,0"
                            Content="+ 添加插件" Click="BtnAddPlugin_Click"/>
                    <TextBlock x:Name="ChainCount" Grid.Column="3" Text="0 个插件" FontSize="12"
                               Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 底部固定区（先占 Top/Bottom，滚动区填剩余）-->
                <StackPanel DockPanel.Dock="Bottom">

                    <!-- ── Send 区（橙）── -->
                    <Border Background="{DynamicResource SendBrush}" Padding="25,12,25,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Send Volume" FontSize="12"
                                           Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="SendMasterSlider" Grid.Column="1" Margin="10,0,10,0"
                                        Style="{StaticResource MacSlider}"
                                        Minimum="-60" Maximum="12" Value="0"
                                        ValueChanged="SendMasterSlider_ValueChanged"/>
                                <TextBlock x:Name="SendMasterDb" Grid.Column="2" Text="+0.0 dB" FontSize="12"
                                           FontFamily="Consolas" Foreground="{DynamicResource SecondaryBrush}"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                                <Button x:Name="BtnSendMute" Grid.Column="3" Content="静音" FontSize="11" Height="24"
                                        Padding="10,0,10,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Click="BtnSendMute_Click" ToolTip="静音 / 取消静音两个 Send 效果器"/>
                            </Grid>
                            <StackPanel x:Name="SendARow" Margin="0,10,0,0"/>
                            <StackPanel x:Name="SendBRow" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource SepBrush}"/>

                    <!-- ── 虚拟输入区（绿，对应苹果版 AUX 输入位置）── -->
                    <Border Background="{DynamicResource AuxBrush}" Padding="25,12,25,12">
                        <StackPanel>
                            <TextBlock Text="虚拟输入（音乐/音效软件进声）" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryBrush}"/>
                            <StackPanel x:Name="AuxRows" Margin="0,10,0,0">
                                <Grid x:Name="AuxRowC"/>
                                <Grid x:Name="AuxRowD" Margin="0,10,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="Wdm2vstHint" Text="" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TertiaryBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BtnMasterOut" Content="总输出设置" FontSize="11" Height="24" Padding="10,0,10,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="BtnMasterOut_Click"
                                        ToolTip="打开 VST2WDM Ultra 的界面，确认总输出端口（Ultra REC 01/02）"/>
                                <!-- 输出前效果器插入栏（限制器）：在所有声音之后、总推子之前 -->
                                <StackPanel x:Name="PostSlot" Margin="8,0,0,0" Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource SepBrush}"/>

                    <!-- ── 底部按钮行 + 品牌 ── -->
                    <Grid Margin="25,12,25,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnRecord" Height="32" Style="{StaticResource AccentButton}"
                                Content="● 录音" FontSize="12" Padding="12,0" Click="BtnRecord_Click" ToolTip="开始录音"/>
                        <Button x:Name="BtnFolder" Grid.Column="1" Height="32" Margin="8,0,0,0"
                                Content="📁 文件夹" FontSize="12" Padding="8,0" Click="BtnFolder_Click" ToolTip="打开录音文件夹"/>
                        <Button x:Name="BtnLoadPreset" Grid.Column="2" Height="32" Margin="8,0,0,0"
                                Content="⤓ 载入预设" FontSize="12" Padding="8,0" Click="BtnLoadPreset_Click" ToolTip="加载预设"/>
                        <Button x:Name="BtnSavePreset" Grid.Column="3" Height="32" Margin="8,0,0,0"
                                Content="💾 保存预设" FontSize="12" Padding="8,0" Click="BtnSavePreset_Click" ToolTip="保存预设"/>
                        <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="新声代音乐服务" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="混音制作、主播调试、音频硬件" FontSize="12"
                                       Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 主插件链（可滚动，填充剩余空间）-->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25,0,25,10">
                        <TextBlock x:Name="ChainEmptyHint" Text="还没有插件" FontSize="14"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,30,0,30"/>
                        <StackPanel x:Name="ChainList"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource SepBrush}"/>

            <!-- ═══════════ 窄栏：电平表 + 主音量 ═══════════ -->
            <DockPanel Grid.Column="2" Background="{DynamicResource SideBrush}" Margin="0,0,0,0">
                <StackPanel x:Name="MetersHost" DockPanel.Dock="Top" Orientation="Horizontal"
                            Height="225" HorizontalAlignment="Center" Margin="0,20,0,12"/>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SepBrush}"
                        Margin="4,0"/>
                <Button x:Name="BtnMute" DockPanel.Dock="Bottom" Height="36" Margin="0,10,0,20"
                        Content="🎙" FontSize="14" Click="BtnMute_Click" ToolTip="闭麦（静音话筒输入）"/>
                <Grid x:Name="MasterFaderHost" Margin="0,8,0,8"/>
            </DockPanel>

            <Border x:Name="DeviceSep" Grid.Column="3" Background="{DynamicResource SepBrush}"/>

            <!-- ═══════════ 右栏：设备 + 格式 + 快捷键 + 二维码 ═══════════ -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource SideBrush}">
                <StackPanel Margin="25,20,25,20">

                    <TextBlock Text="INPUT" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="AsioDriverCombo" Grid.Column="1"
                                  SelectionChanged="AsioDriver_SelectionChanged"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Channel" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="InputChannelCombo" Grid.Column="1"
                                  SelectionChanged="InputChannel_SelectionChanged"/>
                    </Grid>

                    <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="OutputDriverCombo" Grid.Column="1" IsEnabled="False"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Channel" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="OutputChannelCombo" Grid.Column="1"
                                  SelectionChanged="OutputChannel_SelectionChanged"/>
                    </Grid>

                    <TextBlock Text="FORMAT" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sample Rate" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="SampleRateCombo" Grid.Column="1"
                                  SelectionChanged="SampleRate_SelectionChanged"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Buffer" Style="{StaticResource RowLabel}"/>
                        <Border Grid.Column="1" Height="32" CornerRadius="6"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource SepBrush}" BorderThickness="1">
                            <TextBlock x:Name="BufferText" Text="由声卡决定" FontSize="12"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="SHORTCUT" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="静音快捷键" Style="{StaticResource RowLabel}"/>
                        <Button x:Name="HotkeyButton" Grid.Column="1" Height="32" FontSize="12"
                                Content="点击录制…" Click="HotkeyButton_Click" ToolTip="点击后按下组合键（全局生效）"/>
                        <Button x:Name="ClearHotkeyButton" Grid.Column="2" Height="32" Width="56"
                                Style="{StaticResource SmallButton}" Margin="8,0,0,0" FontSize="12"
                                Content="清除" Click="ClearHotkeyButton_Click"/>
                    </Grid>

                    <!-- 二维码 -->
                    <StackPanel Margin="0,30,0,0">
                        <Border Background="White" CornerRadius="10" Width="150" Height="150"
                                HorizontalAlignment="Center" Padding="6">
                            <Image Source="/XSDAudioRack;component/QRCode.jpg" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="扫一扫加微信" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TertiaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
